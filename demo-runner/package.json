{
  "name": "@cepid/demo-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Maintainer-side demo orchestrator: runs the two-run constraint-gate proof (register → trade → lose → scar → DENY) against the live stack and chain, driven by the UI. Not part of the product surface.",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --import tsx \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cepid/client": "0.1.0",
    "@cepid/agent-demo-trader": "0.1.0",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@cepid/server": "0.1.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
