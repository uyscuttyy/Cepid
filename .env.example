# CEPID — environment configuration
# Copy to .env and fill in. Never commit .env.

# --- CEPID API (the product) ----------------------------------------------
CEPID_PORT=8787
CEPID_SIDECAR_URL=http://127.0.0.1:8765
SIDECAR_TOKEN=dev-sidecar-token
# Demo agent's CEPID credentials (register at /v1/agents/register)
CEPID_API_URL=http://127.0.0.1:8787
CEPID_API_KEY=

# --- Sibyl sidecar (substrate) --------------------------------------------
CEPID_MEMORY_DB=~/.sibyl-memory/cepid-memory.db

# --- Networks ---------------------------------------------------------------
# base-sepolia = on-chain demo market (chainId 84532)
# mock        = in-memory market for tests
CEPID_NETWORK=base-sepolia
CEPID_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
CEPID_TEST_MARKET_ADDRESS=

# --- Demo agent wallet (D4: throwaway, user funds via faucet) --------------
# DEMO_AGENT_ADDR=0x314A836626C38FaA1Fcd1245e5f56260BA3cf3F1
DEMO_AGENT_PRIVATE_KEY=

# --- CEPID x402 payment receiver (D4: throwaway, user funds via faucet) ----
# CEPID_PAYMENT_ADDR=0xB766c186D260f2F9e704ABad2Fa58A4Fed6A27d6
CEPID_PAYMENT_WALLET_KEY=
CEPID_QUERY_PRICE=$0.01

# --- Risk -------------------------------------------------------------------
CEPID_MAX_COLLATERAL=0.50
CEPID_SESSION_MAX_COLLATERAL=1.00
CEPID_SESSION_MAX_ORDERS=3
CEPID_MAX_SLIPPAGE_BPS=200

# --- Persistence ------------------------------------------------------------
CEPID_DATA_DIR=./data

# --- Limitless (only when CEPID_NETWORK=base; NOT part of the demo) --------
LMTS_TOKEN_ID=
LMTS_TOKEN_SECRET=
LMTS_OWNER_ID=
