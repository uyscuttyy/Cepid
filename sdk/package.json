    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@x402/core": "2.24.0",
    "@x402/evm": "2.24.0",
    "@x402/fetch": "2.24.0",
    "viem": "^2.55.19"
  }
}
