{
  "name": "@cepid/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SDK for external agents: cepid.retrieve() / cepid.recordDecision() / cepid.recordOutcome() over HTTP, with the x402 payment flow built in.",
